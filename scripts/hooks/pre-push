#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

./scripts/draw-keymap.sh

if ! git diff --quiet -- \
  docs/keymap.yaml docs/keymap.svg \
  docs/keymap-linux.yaml docs/keymap-linux.svg; then
  cat >&2 <<'MSG'
Keymap diagrams were regenerated during pre-push.
Commit the generated docs/keymap*.yaml and docs/keymap*.svg files, then push again.
MSG
  exit 1
fi
